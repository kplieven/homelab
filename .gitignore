# Superpowers brainstorm sessions
.superpowers/

# Git worktrees
.worktrees/

# Environment files
.env
**.env
!**.env.example

# Configs
**/config/
!services/home-assistant/config/configuration.yaml
!services/home-assistant/config/ui-lovelace.yaml
!services/home-assistant/config/dashboards/
!services/home-assistant/config/dashboards/**
**/data/
**/metadata/
**/database/
**/storage/
**/logs/
**/private/
**/library/
**/customFiles/
**/pipeline/
**/trainingData/
**.db
**.sqlite

# Backup db dumps
**/db-dump
**/*.tmp


# Exported user documents — paperless-ngx dumps real scanned documents here.
services/paperless-ngx/export/

# Service runtime state not caught by the generic rules above.
**/meili_data/
**/ferretdb-state/
**/mam-seedboxapi/tmp/

# Local-only pre-commit patterns (holds this machine's literal private values).
scripts/hooks/local-patterns.txt

# Secret files (API keys mounted into containers)
*.secret
# Gluetun control-server API key. Path-independent so moving the stack between
# service directories cannot silently un-ignore it.
**/gluetun/auth/config.toml

# Editor / script backups, including the timestamped ones the migration
# scripts leave behind (Caddyfile.bak-20260909-135739 and friends).
*.bak
*.bak-*

# Personal projects hosted here but developed elsewhere -- not part of this repo.
services/budkin/
services/investment-tracker/
services/steel-design-planner/
services/personal-website/

# ext4 volume root (mp0 mounts at /srv/homelab)
lost+found/

# Import state: rewritten by the import timers, restored by restic with HOMELAB_DIR
services/books-stack/imported-*-hashes.txt
services/books-stack/import-new-books.sh.bak-*

# Jellyfin runtime state: the config/ dir is covered by the generic rule, the
# pre-migration database dumps are not.
services/media-stack/jellyfin/db-backup-*/
