# --- Paths and locale -------------------------------------------------------
# Root of the bulk media library (mountpoint on this machine)
MEDIA_ROOT=
# Root of the torrent download tree (mountpoint on this machine)
TORRENT_ROOT=
# The timezone for all containers (TZ identifier, e.g. Etc/UTC)
TZ=Etc/UTC

# --- Calibre Web Automated --------------------------------------------------
# Host path to the Calibre library
CALIBRE_LIBRARY_PATH=
# The port the service will be exposed on
CALIBRE_WEB_PORT=8083
# Hardcover token, used as a metadata provider (https://hardcover.app)
HARDCOVER_API_KEY=

# --- MyAnonaMouse -----------------------------------------------------------
# mam and seedboxapi share the network namespace of the gluetun container in
# ../gluetun, which is also where their ports are published.
# Web UI login for the MAM qBittorrent instance
MAM_USERNAME=
MAM_PASSWORD=
# MAM session cookie, used by the seedbox API sidecar to keep the session alive
MAM_SESSION_ID=

# --- Homepage widget API keys -----------------------------------------------
# Found in the service's own settings UI.
AUDIOBOOKSHELF_API_KEY=

# --- Homepage links ---------------------------------------------------------
# The URL the homepage dashboard links to for each service.
CALIBRE_WEB_HOMEPAGE_URL=
AUDIOBOOKSHELF_URL=
MAM_URL=
