# The URL that the homepage will link to
URL=
# The port the service will be exposed on
PORT=8742
# The timezone for this machine (TZ identifier, e.g. Etc/UTC)
TZ=Etc/UTC
# Host path of the game library (see the RomM folder-structure docs)
ROMM_LIBRARY=

# Session signing key. Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=

# --- Database ---------------------------------------------------------------
# Password for the romm-user account RomM connects with
DB_PASSWD=
# MariaDB root password. Nothing uses it day to day, but the image refuses to
# initialise an empty database without one.
MARIADB_ROOT_PASSWORD=

# --- Metadata providers -----------------------------------------------------
# https://docs.romm.app/latest/getting-started/metadata-providers/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=
RETROACHIEVEMENTS_API_KEY=
STEAMGRIDDB_API_KEY=

# --- Homepage widget --------------------------------------------------------
# RomM's widget API takes a login, not a key. Use a dedicated viewer account.
HOMEPAGE_USERNAME=
HOMEPAGE_PASSWORD=
