# --- VPN provider -----------------------------------------------------------
# All torrent traffic from other stacks is routed through this container. See
# https://github.com/qdm12/gluetun-wiki for provider-specific setup.
# Your VPN provider, as named by Gluetun (e.g. mullvad, protonvpn)
VPN_SERVICE_PROVIDER=
# Protocol to use: openvpn or wireguard
VPN_TYPE=
# OpenVPN credentials (only needed when VPN_TYPE=openvpn)
OPENVPN_USER=
OPENVPN_PASSWORD=

# --- Control server ---------------------------------------------------------
# Consumed by the Homepage gluetun widget. Since v3.40 every control-server
# route is private by default, so auth/config.toml must grant the widget's
# route explicitly. Generate a key with:  docker run --rm qmcgaw/gluetun genkey
GLUETUN_URL=
GLUETUN_API_KEY=

# --- Locale -----------------------------------------------------------------
# The timezone for all containers (TZ identifier, e.g. Etc/UTC)
TZ=Etc/UTC
