# The port the service will be exposed on
PORT=3001
# The local IP of your server
SERVER_IP=
# The URL that the homepage will link to
HOMEPAGE_URL=
# Absolute path to an image to be used as background
BACKGROUND_IMAGE_PATH=
# Disk mountpoint shown by the resources widget (mounted at the same path inside)
MEDIA_DISK_PATH=
# Dashboard title
TITLE=Homelab
# Timezone / weather location
TZ=Etc/UTC

WEATHER_LABEL=

LATITUDE=

LONGITUDE=
