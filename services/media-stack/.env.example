# --- Paths and locale -------------------------------------------------------
# Root of the bulk media library (mountpoint on this machine).
# media/ and torrents/ are expected underneath it.
MEDIA_ROOT=
# The timezone for all containers (TZ identifier, e.g. Etc/UTC)
TZ=Etc/UTC

# --- VPN (Gluetun) ----------------------------------------------------------
# All download traffic is routed through this container. See
# https://github.com/qdm12/gluetun-wiki for provider-specific setup.
# Your VPN provider, as named by Gluetun (e.g. mullvad, protonvpn)
VPN_SERVICE_PROVIDER=
# Protocol to use: openvpn or wireguard
VPN_TYPE=
# OpenVPN credentials (only needed when VPN_TYPE=openvpn)
OPENVPN_USER=
OPENVPN_PASSWORD=
# Control-server API key, used by the Homepage gluetun widget
GLUETUN_API_KEY=

# --- Torrent clients --------------------------------------------------------
# Web UI login for the general-purpose qBittorrent instance
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# MyAnonaMouse account, used by the second qBittorrent instance
MAM_USERNAME=
MAM_PASSWORD=
# MAM session cookie, used by the seedbox API sidecar to keep the session alive
MAM_SESSION_ID=

# --- Homepage widget API keys -----------------------------------------------
# One per service; each is found in that service's own settings UI
# (usually Settings -> General -> API Key).
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
JELLYSEERR_API_KEY=
AUDIOBOOKSHELF_API_KEY=

# --- Homepage links ---------------------------------------------------------
# The URL the homepage dashboard links to for each service.
PROWLARR_URL=
SONARR_URL=
RADARR_URL=
BAZARR_URL=
JELLYFIN_URL=
GLUETUN_URL=
QBITTORRENT_URL=
MAM_URL=
JELLYSEERR_URL=
AUDIOBOOKSHELF_URL=
