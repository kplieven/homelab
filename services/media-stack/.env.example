# --- Paths and locale -------------------------------------------------------
# Root of the bulk media library (mountpoint on this machine)
MEDIA_ROOT=
# Root of the torrent download tree (mountpoint on this machine)
TORRENT_ROOT=
# The timezone for all containers (TZ identifier, e.g. Etc/UTC)
TZ=Etc/UTC

# --- Torrent client ---------------------------------------------------------
# qBittorrent shares the network namespace of the gluetun container defined in
# ../gluetun, which is also where its WebUI port is published. Bring that stack
# up first. MAM's client now lives in ../books-stack.
# Web UI login for the general-purpose qBittorrent instance
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# --- Homepage widget API keys -----------------------------------------------
# One per service; each is found in that service's own settings UI
# (usually Settings -> General -> API Key).
PROWLARR_API_KEY=
SONARR_API_KEY=
RADARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
JELLYSEERR_API_KEY=
# SuggestArr has no homepage widget, so it needs no API key here. Its own keys
# (Jellyfin, Seerr, TMDb) are entered in its web UI and stored in
# suggestarr/config_files/config.yaml.

# --- Homepage links ---------------------------------------------------------
# The URL the homepage dashboard links to for each service.
PROWLARR_URL=
SONARR_URL=
RADARR_URL=
BAZARR_URL=
JELLYFIN_URL=
QBITTORRENT_URL=
JELLYSEERR_URL=
SUGGESTARR_URL=

# --- SuggestArr ------------------------------------------------------------
# The app binds this port inside the container too, so it is not a host-side
# mapping you can change freely -- compose uses it on both sides.
SUGGESTARR_PORT=5000
# info, debug, warning, error
SUGGESTARR_LOG_LEVEL=info
