# The port that will be used for metrics
PORT=2019
# The local IP of your server
SERVER_IP=
# The URL that will be used by the Caddy homepage widget
HOMEPAGE_WIDGET_URL=http://${SERVER_IP}:${PORT}
# Your domain
DOMAIN=
# Cloudflare API key for TLS
CF_API_KEY=
# Basic-auth credentials for the hdd.* static site.
#   hash: docker exec caddy caddy hash-password --plaintext '<password>'
# Double every $ in the hash -- compose interpolates env_file values, so a bare
# $2a$14$p... arrives truncated and basic auth silently rejects every password.
HDD_AUTH_USER=
HDD_AUTH_HASH=
